# ==============================================================================
# AWS & S3 Storage Credentials
# ==============================================================================
DEFAULT_REGION_AWS=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ==============================================================================
# SQS (Message Queue Broker)
# ==============================================================================
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/scraping-tasks-static
SQS_QUEUE_URL_DYNAMIC=http://localhost:4566/000000000000/scraping-tasks-dynamic
SQS_REGION=us-east-1

# ==============================================================================
# Tiered Storage Architecture (MinIO Landing Zone -> AWS S3 Analytical Lake)
# ==============================================================================
# Fallback / Default S3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=scraping-data-lake
S3_PREFIX_RAW_DATA=raw-data
S3_PREFIX_COMPACTED_DATA=compacted-data
S3_REGION=us-east-1

# Modo A (Híbrido VPS): Landing Zone en MinIO Local (Coste 0€, latencia < 2ms)
RAW_S3_ENDPOINT_URL=http://localhost:9000
RAW_S3_BUCKET_NAME=scraping-data-lake
RAW_S3_REGION=us-east-1
RAW_AWS_ACCESS_KEY_ID=test
RAW_AWS_SECRET_ACCESS_KEY=test

# Destino Consolidado: AWS S3 Cloud (o Emulador Local / MinIO)
TARGET_S3_ENDPOINT_URL=http://localhost:4566
TARGET_S3_BUCKET_NAME=scraping-data-lake
TARGET_S3_REGION=us-east-1
TARGET_AWS_ACCESS_KEY_ID=test
TARGET_AWS_SECRET_ACCESS_KEY=test

# Estrategia de Disco VPS: Borrar JSONL crudos tras confirmar subida de Parquet
DELETE_RAW_AFTER_COMPACTION=True
RAW_DATA_RETENTION_DAYS=7

# ==============================================================================
# Services: Producer & Worker
# ==============================================================================
NUM_MAX_TASKS=10
PRODUCER_PORT=8000
WORKER_NUM_MAX_CONCURRENT_TASKS=60
WORKER_NUM_MAX_CONCURRENT_TASKS_DYNAMIC=3
WORKER_NUM_MAX_CONCURRENT_TASKS_STATIC=60

# ==============================================================================
# Proxy & Network Routing
# ==============================================================================
PROXY_ENABLED=False
PROXY_MODE=static_pool
PROXY_STATIC_LIST=""
PROXY_URL=""
PROXY_STATIC_CHECK_INTERVAL=30.0
PROXY_STATIC_IDLE_THRESHOLD=180.0
PROXY_MAX_POOL_SIZE=10
PROXY_IDLE_TIMEOUT=300.0
PROXY_MAX_REQUESTS_PER_SESSION=100
PROXY_MIN_REQUESTS_PER_SESSION=10

# ==============================================================================
# Playwright Resource & Memory Management
# ==============================================================================
PLAYWRIGHT_MAX_TASKS_PER_BROWSER=25
PLAYWRIGHT_V8_MAX_OLD_SPACE_SIZE_MB=512

# ==============================================================================
# Redis (Distributed Rate Limiting & robots.txt Cache)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# PostgreSQL (Domain Governance Policies)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webscraping_db
