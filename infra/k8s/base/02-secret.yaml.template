apiVersion: v1
kind: Secret
metadata:
  name: scraping-secrets
  namespace: web-scraping-distributed
type: Opaque
stringData:
  # ==============================================================================
  # 1. AWS & SQS Broker Credentials (Amazon SQS Real o Floci Local)
  # ==============================================================================
  AWS_ACCESS_KEY_ID: "test"
  AWS_SECRET_ACCESS_KEY: "test"
  DEFAULT_REGION_AWS: "us-east-1"
  SQS_ENDPOINT_URL: "http://emulator-aws.web-scraping-distributed.svc.cluster.local:4566"
  SQS_QUEUE_URL_STATIC: "http://emulator-aws.web-scraping-distributed.svc.cluster.local:4566/000000000000/scraping-tasks-static"
  SQS_QUEUE_URL_DYNAMIC: "http://emulator-aws.web-scraping-distributed.svc.cluster.local:4566/000000000000/scraping-tasks-dynamic"

  # ==============================================================================
  # 2. Tier 1: Landing Zone en MinIO Local VPS (Micro-escrituras JSONL a coste 0€)
  # ==============================================================================
  RAW_S3_ACCESS_KEY_ID: "minioadmin"
  RAW_S3_SECRET_ACCESS_KEY: "minioadmin"
  RAW_S3_ENDPOINT_URL: "http://minio-service.web-scraping-distributed.svc.cluster.local:9000"
  RAW_S3_BUCKET_NAME: "scraping-data-lake"

  # Prefijos de particionado en el Data Lake
  S3_PREFIX_RAW_DATA: "raw-data"
  S3_PREFIX_COMPACTED_DATA: "compacted-data"

  # ==============================================================================
  # 3. Tier 2: Analytical Data Lake en Cloudflare R2 (Parquet ZSTD Compactado)
  # ==============================================================================
  TARGET_S3_ACCESS_KEY_ID: "tu_access_key_id_de_cloudflare_r2"
  TARGET_S3_SECRET_ACCESS_KEY: "tu_secret_access_key_de_cloudflare_r2"
  TARGET_S3_ENDPOINT_URL: "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
  TARGET_S3_BUCKET_NAME: "scraping-data-lake"

  # ==============================================================================
  # 4. Proxy Residencial (Opcional - SEC EDGAR usa enrutamiento directo a coste 0€)
  # ==============================================================================
  PROXY_STATIC_LIST: ""
  PROXY_URL: ""

  # ==============================================================================
  # 5. Base de Datos de Gobernanza (PostgreSQL 16)
  # ==============================================================================
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "postgres_password"